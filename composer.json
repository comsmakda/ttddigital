{
    "name": "comsmkn2pinrang/ttd-digital",
    "description": "Sistem TTD Digital & Verifikasi QR Code - Community Programmer SMKN 2 Pinrang",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-gd": "*",
        "endroid/qr-code": "^5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
