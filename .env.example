APP_NAME="TTD Digital - COM SMKN 2 Pinrang"
APP_ENV=production
# APP_URL harus berupa URL final tanpa trailing slash, mis: https://ttd.comsmkn2pinrang.sch.id
APP_URL=http://localhost:8080
APP_DEBUG=false

DB_HOST=db
DB_PORT=3306
DB_NAME=ttd_digital
DB_USER=ttd_user
DB_PASS=ttd_pass

SESSION_NAME=ttd_digital_session
SESSION_LIFETIME=7200

# Kredensial admin default yang dibuat otomatis saat pertama kali aplikasi jalan
# (kalau tabel admins masih kosong). Silakan ganti setelah login pertama.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
